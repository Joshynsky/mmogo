# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# Nothing in the app reads this file at runtime; it is for release tooling only.

GITHUB_REPO_URL=
APP_ID=io.github.joshynsky.mymog

# Release signing (Phase 7). The keystore FILE lives OUTSIDE this folder,
# with a backup in a second place. Losing it means users cannot update.
KEYSTORE_PATH=
KEYSTORE_STORE_PASSWORD=
KEYSTORE_KEY_ALIAS=mymog
KEYSTORE_KEY_PASSWORD=
